VITE_API_URL=http://localhost:8000/api/v1

# Real-time notifications (Laravel Echo over the Pusher protocol).
# Leave VITE_REALTIME_ENABLED unset/true; the app degrades to plain HTTP
# when the socket server is unreachable.
VITE_REALTIME_ENABLED=true
VITE_REVERB_APP_KEY=local-reverb-key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=http
# VITE_BROADCAST_AUTH_ENDPOINT=http://localhost:8000/broadcasting/auth
